# Publish only source, build inputs, and essential project notices.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/DISCLAIMER.md
!/THIRD_PARTY_NOTICES.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/app/

/app/*
!/app/build.gradle.kts
!/app/proguard-release.pro
!/app/src/

/gradle/*
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

**/build/
**/__pycache__/
*.py[cod]
*.apk
*.apkm
*.apks
*.aab
*.dex
*.class
*.log
*.jks
*.keystore
*.p12
*.pem
*.key
*.pfx
.env
.env.*
local.properties
keystore.properties
signing.properties
release-signing.properties
