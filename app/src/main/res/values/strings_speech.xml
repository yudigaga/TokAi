    <string name="speech_fish_default_voice_hint">Leave empty for the API default voice. Enter a reference voice ID here, not a speech engine name.</string>
    <string name="speech_fish_drama_tags">Drama 3 supports natural language instructions, sounds, pauses and paired tags in text. Follow the engine\'s documentation.</string>
    <string name="speech_fish_expression_hint">S2 models support [style descriptions] in text to control expression. This page does not rewrite the text to synthesize.</string>
    <string name="speech_fish_filters_hint">Voice and title languages allow multiple selections and custom Fish language IDs, one per line. Up to 5 tags. Set filters before refreshing. Defaults to Chinese, 20 per page, up to 200 loaded. Public voices can be browsed directly; My voices requires an API Key. Turning off the license filter means any status, not unlicensed. An empty voice ID uses the API default.</string>
    <string name="speech_fish_generation">Fish Audio generation parameters</string>
    <string name="speech_fish_header">Single speaker voices · %1$s</string>
    <string name="speech_fish_inactive">Switch to Fish Audio to configure this.</string>
